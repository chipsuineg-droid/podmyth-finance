// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── PRODUCT CATALOG ───────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String    @id
  name             String
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  isService        Boolean   @default(false)
  defaultSellPrice Decimal   @default(0)
  variants         Variant[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([categoryId])
}

model Variant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  color             String          @default("N/A")
  size              String          @default("N/A")
  sku               String          @unique
  defaultBuyPrice   Decimal         @default(0)
  defaultSellPrice  Decimal         @default(0)
  stockQty          Int             @default(0)
  lowStockThreshold Int             @default(2)
  stockMovements    StockMovement[]
  documentItems     DocumentItem[]
  stockTakeLines    StockTakeLine[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productId])
}

// ─── CLIENTS ───────────────────────────────────────────────────────────────────

model Client {
  id           String     @id @default(cuid())
  name         String
  phone        String?
  email        String?
  city         String?
  deliveryZone String?
  notes        String?
  documents    Document[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── DOCUMENTS (QUOTES + INVOICES) ─────────────────────────────────────────────

model Document {
  id             String         @id @default(cuid())
  refNumber      String         @unique
  type           String // QUOTATION | INVOICE
  status         String         @default("DRAFT")
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  issueDate      DateTime       @default(now())
  dueDate        DateTime?
  paidDate       DateTime?
  paymentMethod  String? // USD_CASH | ECOCASH | INNBUCKS | BANK_NOSTRO
  items          DocumentItem[]
  totalSellPrice Decimal        @default(0)
  totalBuyPrice  Decimal        @default(0)
  netProfit      Decimal        @default(0)
  profitMargin   Decimal        @default(0)
  amountPaid     Decimal        @default(0)
  notes          String?
  terms          String         @default("Payment Terms: Payment is strictly due after delivery of services / receipt of items.")
  sourceQuoteId  String?
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientId])
  @@index([type, status])
  @@index([issueDate])
}

model DocumentItem {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id])
  description  String
  notes        String?
  qty          Int      @default(1)
  buyingPrice  Decimal  @default(0)
  sellingPrice Decimal  @default(0)
  lineTotal    Decimal  @default(0)
  lineCost     Decimal  @default(0)
  lineProfit   Decimal  @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId])
  @@index([variantId])
}

// ─── PAYMENTS ──────────────────────────────────────────────────────────────────

model Payment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  amount     Decimal
  method     String // USD_CASH | ECOCASH | INNBUCKS | BANK_NOSTRO
  paidAt     DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// ─── STOCK MOVEMENTS ───────────────────────────────────────────────────────────

model StockMovement {
  id           String   @id @default(cuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id])
  type         String // INBOUND | SALE | RETURN | ADJUSTMENT | SHRINKAGE
  qty          Int
  buyingPrice  Decimal  @default(0)
  sellingPrice Decimal  @default(0)
  referenceId  String?
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([variantId])
  @@index([type])
  @@index([createdAt])
}

// ─── STOCK TAKES ───────────────────────────────────────────────────────────────

model StockTake {
  id           String          @id @default(cuid())
  status       String          @default("OPEN") // OPEN | RECONCILED
  notes        String?
  lines        StockTakeLine[]
  createdAt    DateTime        @default(now())
  reconciledAt DateTime?
}

model StockTakeLine {
  id            String    @id @default(cuid())
  stockTakeId   String
  stockTake     StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variantId     String
  variant       Variant   @relation(fields: [variantId], references: [id])
  systemCount   Int
  physicalCount Int       @default(0)
  variance      Int       @default(0)
  varianceValue Decimal   @default(0)

  @@index([stockTakeId])
  @@index([variantId])
}

// ─── OVERHEAD EXPENSES ─────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  category    String // PACKAGING | MARKETING | EQUIPMENT | TRANSPORT | REPAYMENT | DOMAIN | LUNCH | OTHER
  description String
  amount      Decimal
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// ─── RECONCILIATION & ACTION POINTS ───────────────────────────────────────────

model ActionPoint {
  id          String   @id @default(cuid())
  title       String
  amount      Decimal  @default(0)
  category    String   // COLLECT_CLIENT | CASH_IN | WITHDRAWAL | OPERATIONAL
  person      String?
  status      String   @default("PENDING") // PENDING | COMPLETED
  notes       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

// ─── MEMBER SUBSCRIPTIONS ─────────────────────────────────────────────────────

model MemberSubscription {
  id         String   @id @default(cuid())
  memberName String
  month      String   // e.g. "September", "October", "November"
  year       Int      @default(2026)
  amount     Decimal  @default(10)
  status     String   @default("PAID") // PAID | PENDING
  notes      String?
  createdAt  DateTime @default(now())
}

// ─── SEQUENCE COUNTERS ─────────────────────────────────────────────────────────

model Sequence {
  id      String @id // "QUOTATION" | "INVOICE"
  year    Int
  counter Int    @default(0)
}
